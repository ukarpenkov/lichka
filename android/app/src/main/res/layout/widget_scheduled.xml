<?xml version="1.0" encoding="utf-8"?>
<!--
  Neo-brutal plate as three shape ImageViews (not a stretched bitmap).
  Shape cornerRadius stays circular when the widget is resized; bitmaps with
  fitXY were turning corners elliptical and thickening the side borders.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hard shadow (ink), offset bottom-right -->
    <ImageView
        android:id="@+id/widget_plate_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_plate_round" />

    <!-- Outer plate (ink) = border color -->
    <ImageView
        android:id="@+id/widget_plate_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_plate_round" />

    <!-- Inner canvas inset by 2dp border (margins: left/top 2, right/bottom 2+4 shadow) -->
    <ImageView
        android:id="@+id/widget_plate_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_plate_round_inner" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/press_start_2p_regular"
            android:maxLines="1"
            android:text="@string/widget_scheduled_title"
            android:textColor="@color/widget_ink"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:gravity="center"
            android:text="@string/widget_scheduled_empty"
            android:textColor="@color/widget_ink_muted"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:fadeScrollbars="true"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
