<?xml version="1.0" encoding="utf-8"?>
<!--
  Plate is a single ImageView; colors come from a PNG via FileProvider URI
  (not setImageViewBitmap — large bitmaps fail Binder intermittently;
  not ImageView tint — tint sticks across theme switches on many launchers).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_plate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_scheduled" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/widget_empty_fallback"
                style="@style/WidgetScheduledEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:breakStrategy="balanced"
                android:hyphenationFrequency="none"
                android:text="@string/widget_scheduled_empty"
                android:textColor="@color/widget_ink_muted" />

            <ImageView
                android:id="@+id/widget_empty_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:visibility="gone" />
        </FrameLayout>

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:fadeScrollbars="true"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
