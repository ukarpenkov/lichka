<?xml version="1.0" encoding="utf-8"?>
<!--
  Neo-brutal / pixel plate: hard offset shadow + solid border (no <stroke>).
  Border is ink fill + canvas inset — avoids AA black crescents at corners
  that appear when a canvas fill is stroked with ink on top.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard shadow (ink), offset bottom-right -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_ink" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Outer plate (ink) = border color -->
    <item
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_ink" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Inner face inset by 2dp border; radius 14 = 16 − 2 -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_canvas" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
