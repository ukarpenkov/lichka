<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-brutal / pixel plate: hard offset shadow + 2dp border; radius larger than AlertDialog (8). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard shadow (ink), offset bottom-right -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_ink" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Face: canvas + solid border -->
    <item
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_canvas" />
            <stroke
                android:width="2dp"
                android:color="@color/widget_ink" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
